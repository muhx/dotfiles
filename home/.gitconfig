# Tracked in a PUBLIC repo. Identity and signing go in ~/.gitconfig.local.
# ~/.gitconfig includes this file (not a link), so `git config --global` does not write here.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[include]
	path = ~/.gitconfig.local
